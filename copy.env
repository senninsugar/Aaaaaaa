# senninproxy を実行するポート番号を設定します。
# PORT=2345

# Bare Server を使用するかどうかを選択します。
# true に設定するか、Vercel を使う場合は変更しないでください。
# BARE="false"

# MASQR を有効にするかどうかを選択します。
# 動作には別途ライセンスサーバーが必要です。
# https://github.com/titaniumnetwork-dev/MasqrProject
# MASQR="false"

# ポップアンダーのオーバーレイを全体で有効にします。
# POPUNDER_ENABLED="false"

# クリック時に開くポップアンダーの遷移先URLです。
# POPUNDER_URL="https://example.com"
